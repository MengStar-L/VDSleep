{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VDSleep",
  "version": "0.1.0",
  "identifier": "com.vdsleep.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VDSleep - 隐私屏幕管理",
        "width": 1328,
        "height": 900,
        "minWidth": 480,
        "minHeight": 400,
        "backgroundColor": "#f8fafc",
        "center": true,
        "decorations": true,
        "resizable": true,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
